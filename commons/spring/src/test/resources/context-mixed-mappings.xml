<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
        The mapping functions are a property of the mappings, so they are registered while the bean
        is created - before any CustomMappings bean contributes a resource that refers to them.
        The bean collects those holders itself, so no configurer and no post processor is needed.
    -->
    <bean id="mappings"
          class="org.openehealth.ipf.commons.spring.map.SpringMappings">
        <property name="mappingFunctions">
            <map>
                <entry key="first4">
                    <bean class="org.openehealth.ipf.commons.spring.map.MixedFormatMappingsTest.First4"/>
                </entry>
            </map>
        </property>
    </bean>

    <!-- one holder per format, plus one that mixes them in a single list -->
    <bean id="legacyMappings" class="org.openehealth.ipf.commons.spring.map.config.CustomMappings">
        <property name="mappingResource" value="classpath:configurer1.map"/>
    </bean>

    <bean id="xmlMappings" class="org.openehealth.ipf.commons.spring.map.config.CustomMappings">
        <property name="mappingResource" value="classpath:configurer7.mapping.xml"/>
    </bean>

    <!-- a resource whose name does not identify its format, so the holder names it for them all -->
    <bean id="unnamedFormatMappings" class="org.openehealth.ipf.commons.spring.map.config.CustomMappings">
        <property name="mappingFormat" value="xml"/>
        <property name="mappingResource" value="classpath:configurer9-unnamed-format"/>
    </bean>

    <bean id="mixedMappings" class="org.openehealth.ipf.commons.spring.map.config.CustomMappings">
        <property name="mappingResources">
            <list>
                <value>classpath:configurer2.map</value>
                <value>classpath:configurer8.mapping.yaml</value>
                <value>classpath:functions.mapping.xml</value>
            </list>
        </property>
    </bean>
</beans>
