<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- the mappings themselves, as a typed Mappings bean -->
    <bean id="mappings" class="org.openehealth.ipf.commons.spring.map.SpringMappings"/>

    <!-- and the untyped service over the very same mappings, for code that still needs it -->
    <bean id="mappingService"
          class="org.openehealth.ipf.commons.spring.map.SpringBidiMappingService">
        <constructor-arg ref="mappings"/>
    </bean>

    <bean id="configurer"
          class="org.openehealth.ipf.commons.spring.map.config.CustomMappingsConfigurer">
        <property name="mappingService" ref="mappings"/>
    </bean>

    <bean id="postProcessor"
          class="org.openehealth.ipf.commons.spring.core.config.SpringConfigurationPostProcessor"/>
</beans>
