        <entry key="1064" value="COC"/>                   <!-- Christian: Church of Christ -->
        <entry key="1065" value="COG"/>                   <!-- Christian: Church of God -->
        <entry key="1068" value="EOT"/>                   <!-- Christian: Eastern Orthodox -->
