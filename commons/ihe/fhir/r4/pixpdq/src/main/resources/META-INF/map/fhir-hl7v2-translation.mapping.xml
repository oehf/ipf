<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ Mappings between HL7v2 code systems and their FHIR counterparts. Most of them are derived
  ~ directly from the FHIR specification.
  ~
  ~ Where several keys map onto one value, all but one are marked narrower so that the value has
  ~ exactly one inverse. The one left as "equal" is in every case the last of the group, which is
  ~ the inverse the Groovy mapping service happened to pick before IPF 6.0; the choice is
  ~ therefore behavior-preserving rather than considered, and worth revisiting per mapping.
  -->
<mappings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://openehealth.org/schema/ipf-commons-map.xsd">

    <mapping name="hl7v2fhir-patient-maritalStatus"
             keySystem="2.16.840.1.113883.5.2"
             valueSystem="http://hl7.org/fhir/v3/MaritalStatus">
        <entry key="A" value="N"/>                              <!-- separated -->
        <entry key="B" value="U"/>                              <!-- unmarried -->
        <entry key="C" value="P"/>                              <!-- common law -->
        <entry key="D" value="D"/>                              <!-- divorced -->
        <entry key="E" value="L" equivalence="narrower"/>        <!-- legally separated -->
        <entry key="G" value="T" equivalence="narrower"/>        <!-- living together -->
        <entry key="I" value="I"/>                              <!-- interlocutory -->
        <entry key="M" value="M"/>                              <!-- married -->
        <entry key="N" value="A"/>                              <!-- anulled -->
        <entry key="L" value="L"/>                              <!-- legally separated -->
        <entry key="O" value="UNK" equivalence="narrower"/>      <!-- other -->
        <entry key="P" value="T" equivalence="narrower"/>        <!-- domestic partner -->
        <entry key="R" value="T"/>                              <!-- registered domestic partner -->
        <entry key="S" value="S"/>                              <!-- never married AKA single -->
        <entry key="T" value="UNK" equivalence="narrower"/>      <!-- unreported -->
        <entry key="U" value="UNK"/>                            <!-- unknown -->
        <entry key="W" value="W"/>                              <!-- widowed -->
        <unmatched mode="fixed" value="UNK"/>                   <!-- unknown stuff -->
    </mapping>

    <mapping name="hl7v2fhir-patient-religion"
             keySystem="2.16.840.1.113883.5.6"
             valueSystem="http://hl7.org/fhir/v3/ReligiousAffiliation">
        <entry key="AGN" value="1004"/>                          <!-- Agnostic -->
        <entry key="ATH" value="1007"/>                          <!-- Atheist -->
        <entry key="BAH" value="1008"/>                          <!-- Baha'i -->
        <entry key="BUD" value="1059"/>                          <!-- Buddhist -->
        <entry key="BMA" value="1029"/>                          <!-- Buddhist: Mahayana -->
        <entry key="BTH" value="1051"/>                          <!-- Buddhist: Theravada -->
        <entry key="ANG" value="1005"/>                          <!-- Christian: Anglican -->
        <entry key="AOG" value="1061"/>                          <!-- Christian: Assembly of God -->
        <entry key="BAP" value="1009"/>                          <!-- Christian: Baptist -->
        <entry key="CAT" value="1041"/>                          <!-- Christian: Roman Catholic -->
        <entry key="CHS" value="1063"/>                          <!-- Christian: Christian Science -->
        <entry key="COC" value="1064"/>                          <!-- Christian: Church of Christ -->
        <entry key="COG" value="1065"/>                          <!-- Christian: Church of God -->
        <entry key="EOT" value="1068" equivalence="narrower"/>    <!-- Christian: Eastern Orthodox -->
        <entry key="EPI" value="1069"/>                          <!-- Christian: Episcopalian -->
        <entry key="FRQ" value="1071" equivalence="narrower"/>    <!-- Christian: Friends -->
        <entry key="GRE" value="1068"/>                          <!-- Christian: Greek Orthodox -->
        <entry key="JWN" value="1025"/>                          <!-- Christian: Jehovah's Witness -->
        <entry key="LUT" value="1028"/>                          <!-- Christian: Lutheran -->
        <entry key="MET" value="1073"/>                          <!-- Christian: Methodist -->
        <entry key="MOM" value="1027"/>                          <!-- Christian: Latter-day Saints -->
        <entry key="NAZ" value="1075"/>                          <!-- Christian: Church of the Nazarene -->
        <entry key="COT" value="1013"/>                          <!-- Christian: Other -->
        <entry key="PEN" value="1038"/>                          <!-- Christian: Pentecostal -->
        <entry key="PRE" value="1076"/>                          <!-- Christian: Presbyterian -->
        <entry key="PRO" value="1077"/>                          <!-- Christian: Protestant -->
        <entry key="QUA" value="1071"/>                          <!-- Christian: Friends -->
        <entry key="REC" value="1079"/>                          <!-- Christian: Reformed Church -->
        <entry key="SAA" value="1080"/>                          <!-- Christian: Salvation Army -->
        <entry key="SEV" value="1001"/>                          <!-- Christian: Seventh Day Adventist -->
        <entry key="UNU" value="1052"/>                          <!-- Christian: Unitarian Universalist -->
        <entry key="CNF" value="1014"/>                          <!-- Confucian -->
        <entry key="HIN" value="1020"/>                          <!-- Hindu -->
        <entry key="JAI" value="1024"/>                          <!-- Jain -->
        <entry key="JEW" value="1026"/>                          <!-- Jewish -->
        <entry key="MOS" value="1023"/>                          <!-- Muslim -->
        <entry key="MSU" value="1049"/>                          <!-- Muslim: Sunni -->
        <entry key="MSH" value="1045"/>                          <!-- Muslim: Shiite -->
        <entry key="NAM" value="1074"/>                          <!-- Native American -->
        <entry key="SHN" value="1046"/>                          <!-- Shintoist -->
        <entry key="SIK" value="1047"/>                          <!-- Sikh -->
        <unmatched mode="fixed" value="UNK"/>
        <!--
          ~ Deliberately unmapped HL7 v2 table 0006 codes, kept for the record:
          ~
          ~ BTA  Buddhist: Tantrayana                 CFR  Chinese Folk Religionist
          ~ CHR  Christian                            ABC  Christian: American Baptist Church
          ~ AMT  Christian: African Methodist Episcopal
          ~ AME  Christian: African Methodist Episcopal Zion
          ~ CRR  Christian: Christian Reformed        CMA  Christian: Christian Missionary Alliance
          ~ COI  Christian: Church of God in Christ   COM  Christian: Community
          ~ COL  Christian: Congregational            EVC  Christian: Evangelical Church
          ~ FWB  Christian: Free Will Baptist         LMS  Christian: Lutheran Missouri Synod
          ~ MEN  Christian: Mennonite                 ORT  Christian: Orthodox
          ~ PRC  Christian: Other Protestant          COP  Christian: Other Pentecostal
          ~ REO  Christian: Reorganized Church of Jesus Christ LDS
          ~ SOU  Christian: Southern Baptist          UCC  Christian: United Church of Christ
          ~ UMD  Christian: United Methodist          UNI  Christian: Unitarian
          ~ WES  Christian: Wesleyan                  WMC  Christian: Wesleyan Methodist
          ~ ERL  Ethnic Religionist                   HVA  Hindu: Vaishnavites
          ~ HSH  Hindu: Shaivites                     HOT  Hindu: Other
          ~ JCO  Jewish: Conservative                 JOR  Jewish: Orthodox
          ~ JOT  Jewish: Other                        JRC  Jewish: Reconstructionist
          ~ JRF  Jewish: Reform                       JRN  Jewish: Renewal
          ~ MOT  Muslim: Other                        NRL  New Religionist
          ~ NOE  Nonreligious                         OTH  Other
          ~ SPI  Spiritist                            VAR  Unknown
          -->
    </mapping>

    <!-- ISO 3166 country codes pass through unchanged in both directions -->
    <mapping name="hl7v2fhir-patient-citizenship"
             keySystem="1.0.3166"
             valueSystem="urn:iso:std:iso:3166">
        <unmatched mode="provided"/>
        <reverse>
            <unmatched mode="provided"/>
        </reverse>
    </mapping>

    <mapping name="hl7v2fhir-address-use"
             keySystem="2.16.840.1.113883.5.290"
             valueSystem="http://hl7.org/fhir/address-use">
        <entry key="H" value="home" equivalence="narrower"/>
        <entry key="L" value="home"/>
        <entry key="O" value="work" equivalence="narrower"/>
        <entry key="B" value="work"/>
        <entry key="BA" value="old"/>
        <unmatched mode="fixed" value=""/>
    </mapping>

    <mapping name="hl7v2fhir-name-use"
             keySystem="2.16.840.1.113883.5.200"
             valueSystem="http://hl7.org/fhir/name-use">
        <entry key="D" value="usual"/>
        <entry key="L" value="official"/>
        <entry key="TEMP" value="temp"/>
        <entry key="N" value="nickname"/>
        <entry key="S" value="anonymous"/>
        <entry key="BAD" value="old"/>
        <entry key="M" value="maiden" equivalence="narrower"/>
        <entry key="B" value="maiden"/>
        <unmatched mode="fixed" value=""/>
    </mapping>

    <mapping name="hl7v2fhir-telecom-use"
             keySystem="2.16.840.1.113883.5.201"
             valueSystem="http://hl7.org/fhir/contact-point-use">
        <entry key="PRN" value="home" equivalence="narrower"/>
        <entry key="ORN" value="home" equivalence="narrower"/>
        <entry key="VHN" value="home"/>
        <entry key="WPN" value="work"/>
        <entry key="PRS" value="mobile"/>
        <unmatched mode="fixed" value=""/>
    </mapping>

    <mapping name="hl7v2fhir-telecom-type"
             keySystem="2.16.840.1.113883.5.202"
             valueSystem="http://hl7.org/fhir/contact-point-system">
        <entry key="PH" value="phone" equivalence="narrower"/>
        <entry key="FX" value="fax"/>
        <entry key="Internet" value="email"/>
        <entry key="BP" value="pager"/>
        <entry key="CP" value="phone"/>
        <unmatched mode="fixed" value="other"/>
    </mapping>

    <mapping name="hl7v2fhir-patient-gender"
             keySystem="http://hl7.org/fhir/administrative-gender"
             valueSystem="2.16.840.1.113883.12.1">
        <entry key="male" value="M"/>
        <entry key="female" value="F"/>
        <entry key="other" value="O"/>
        <entry key="unknown" value="U"/>
        <unmatched mode="fixed" value="O"/>
    </mapping>

    <mapping name="hl7v2fhir-patient-administrativeGender"
             keySystem="2.16.840.1.113883.12.1"
             valueSystem="http://hl7.org/fhir/administrative-gender">
        <entry key="M" value="male"/>
        <entry key="F" value="female"/>
        <entry key="A" value="other" equivalence="narrower"/>
        <entry key="O" value="other"/>
        <entry key="U" value="unknown"/>
        <unmatched mode="fixed" value="other"/>
    </mapping>

    <mapping name="hl7v2fhir-patient-genderIdentity"
             keySystem="2.16.840.1.113883.12.1"
             valueSystem="http://hl7.org/fhir/StructureDefinition/patient-genderIdentity">
        <entry key="M" value="male"/>
        <entry key="F" value="female"/>
        <entry key="A" value="non-binary" equivalence="narrower"/>
        <entry key="D" value="non-binary" equivalence="narrower"/>
        <entry key="I" value="non-binary"/>
        <unmatched mode="fixed" value="other"/>
    </mapping>

</mappings>
