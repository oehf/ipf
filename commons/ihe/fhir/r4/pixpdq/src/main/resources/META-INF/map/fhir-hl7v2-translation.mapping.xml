    <mapping name="fhir2hl7v2-patient-maritalStatus"
             keySystem="http://hl7.org/fhir/v3/MaritalStatus"
             valueSystem="2.16.840.1.113883.12.2">
        <entry key="N" value="A"/>                        <!-- separated -->
        <entry key="U" value="B"/>                        <!-- unmarried -->
