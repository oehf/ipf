<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ipf-commons-ihe-fhir-r4</artifactId>
        <groupId>org.openehealth.ipf.commons</groupId>
        <version>6.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ipf-commons-ihe-fhir-r4-core</artifactId>
    <name>ipf-commons-ihe-fhir-r4-core</name>
    <description>FHIR IHE support for R4</description>


    <dependencies>
        <dependency>
            <!-- the tests read the XML mapping format alongside ConceptMap -->
            <groupId>org.openehealth.ipf.commons</groupId>
            <artifactId>ipf-commons-map-xml</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the tests read the mapping shipped by ipf-commons-ihe-hl7v3 -->
            <groupId>org.openehealth.ipf.commons</groupId>
            <artifactId>ipf-commons-ihe-hl7v3</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the tests load legacy .map files -->
            <groupId>org.openehealth.ipf.commons</groupId>
            <artifactId>ipf-commons-map-groovy</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the ConceptMap mapping loader binds to the mapping model -->
            <groupId>org.openehealth.ipf.commons</groupId>
            <artifactId>ipf-commons-map-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-structures-r4</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openehealth.ipf.commons</groupId>
            <artifactId>ipf-commons-ihe-fhir-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>org.easymock</groupId>
            <artifactId>easymock</artifactId>
        </dependency>
        <dependency>
            <groupId>net.java.quickcheck</groupId>
            <artifactId>quickcheck</artifactId>
        </dependency>
        <!-- shared Hamcrest matchers for Optionals and for the mapping model -->
        <dependency>
            <groupId>org.openehealth.ipf.commons</groupId>
            <artifactId>ipf-commons-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openehealth.ipf.commons</groupId>
            <artifactId>ipf-commons-map-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>