<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans.xsd">

    <import resource="common-xds-beans.xml"/>

    <bean id="routeBuilder"
          class="org.openehealth.ipf.platform.camel.ihe.xds.telemetry.Iti18BraveObservationRouteBuilder"/>

    <!-- exactly what the ipf-ws-spring-boot-starter contributes when ipf.xds.observing is set -->
    <bean id="observationRegistry"
          class="org.openehealth.ipf.platform.camel.ihe.xds.telemetry.BraveObservations"
          factory-method="observationRegistry"/>
    <bean id="observationFeature" class="org.apache.cxf.tracing.micrometer.ObservationFeature">
        <constructor-arg ref="observationRegistry"/>
    </bean>
    <bean id="observationClientFeature" class="org.apache.cxf.tracing.micrometer.ObservationClientFeature">
        <constructor-arg ref="observationRegistry"/>
    </bean>

</beans>
